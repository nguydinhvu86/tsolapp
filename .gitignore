# Environment variables
.env
.env.local
.env.dev
.env.development
.env.production
!.env.example

# Dependencies & Build outputs
node_modules/
.next/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Logs & Debug dumps
*.log
build_log*
ts_err*

# User Uploaded Data (CRITICAL: Never track live uploads in Git)
uploads_data/*
!uploads_data/.gitkeep
uploads/
public/uploads/*
!public/uploads/.gitkeep

# Local Backups & Scratch folders
backups/
implement/
quarantine_remote_scripts/
temp/
tmp_ecatalog/

# Local SQLite DBs
prisma/*.db
prisma/*.db-journal
