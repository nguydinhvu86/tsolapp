# ==========================================
# CẤU HÌNH MÔI TRƯỜNG TRIỂN KHAI (ERP APP)
# Sao chép file này thành .env và cập nhật thông số của site mới
# ==========================================

# 1. Cơ sở dữ liệu MySQL
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/erp_database"

# 2. Xác thực NextAuth & Bảo mật
NEXTAUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXTAUTH_SECRET="thay_doi_chuoi_bi_mat_ngau_nhien_tai_day_32_ky_tu"
ENCRYPTION_KEY="thay_doi_khoa_ma_hoa_32_ky_tu_tai_day"

# 3. Cấu hình SMTP gửi Email mặc định (Có thể cấu hình trong trang Cài đặt hệ thống)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-app-password"
SMTP_FROM_NAME="ERP System"
SMTP_FROM_EMAIL="your-email@domain.com"

# 4. Cấu hình Web Push Notification (Chạy `node scripts/generate-vapid.js` để tạo cặp key mới)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@your-domain.com"

# 5. Cấu hình Tổng đài PBX (Tùy chọn)
PBX_URL=""
PBX_DOMAIN=""
PBX_KEY=""
