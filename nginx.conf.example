server
{
    listen 80;
    listen 443 ssl http2;
    server_name your-domain.com;
    root /www/wwwroot/your-domain.com;

    # SSL Configuration (Cập nhật đường dẫn chứng chỉ SSL của domain mới)
    # ssl_certificate    /www/server/panel/vhost/cert/your-domain.com/fullchain.pem;
    # ssl_certificate_key    /www/server/panel/vhost/cert/your-domain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    add_header Strict-Transport-Security "max-age=31536000";

    client_max_body_size 50M;

    # Phục vụ trực tiếp thư mục uploads cũ (nếu có)
    location ^~ /uploads/ {
        alias /www/wwwroot/your-domain.com/public/uploads/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Next.js Reverse Proxy (Mặc định cổng 6688 theo package.json)
    location / {
        proxy_pass http://127.0.0.1:6688;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Chặn truy cập các file nhạy cảm
    location ~ ^/(\.(user.ini|htaccess|git|env|svn|project)|LICENSE|README.md) {
        return 404;
    }

    location ~ \.well-known {
        allow all;
    }

    access_log  /www/wwwlogs/your-domain.com.log;
    error_log   /www/wwwlogs/your-domain.com.error.log;
}
